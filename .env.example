# QuickBite Core frontend
VITE_APP_NAME=QuickBite
VITE_APP_ENV=development
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_RUNTIME_MODE=core
VITE_API_BASE_URL=http://localhost:3000

# Firebase Authentication / Google Sign-In
VITE_FIREBASE_AUTH_ENABLED=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# QuickBite Core server
DATABASE_URL=
AUTH_JWT_SECRET=
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Firebase token verification (must match VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=

# Protected QuickBite account recovery/provisioning (server secret; never commit the value)
PROTECTED_ADMIN_PASSWORD=

# First-run / administration
VITE_ADMIN_INVITE_CODE=
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Email/notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VITE_NOTIFICATION_PROVIDER=

# Monitoring/analytics
VITE_MONITORING_PROVIDER=console
VITE_MONITORING_DSN=
VITE_ANALYTICS_PROVIDER=none
VITE_ANALYTICS_KEY=
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=

# Domains/CDN
VITE_PRIMARY_DOMAIN=
VITE_CDN_URL=
